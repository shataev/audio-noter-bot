TELEGRAM_TOKEN=
# Required whatever AI_PROVIDER is set to: transcription is always OpenAI.
OPENAI_API_KEY=
NOTION_TOKEN=
NOTION_DATABASE_ID=
# Your Telegram user_id (find it by messaging @userinfobot)
ALLOWED_USER_ID=
# Your timezone, for example Europe/Moscow
TIMEZONE=Europe/Moscow

# When a diary day ends. A note dictated at 01:30 belongs to the day just lived
# through, not to the one that started ninety minutes ago, so anything before
# this hour is filed under the previous date. The date picker, the daily summary
# and the weekly report all use the same boundary. 0 gives calendar days.
DIARY_DAY_START_HOUR=4

# --- Optional. Every value below has a default; leave it unset to keep current behaviour. ---

# Which API the chat models are called through: openai or anthropic.
# Transcription ignores this and always goes to OpenAI — there is no Anthropic
# equivalent of the audio endpoint — so OPENAI_API_KEY is required either way.
AI_PROVIDER=openai
# Required only when AI_PROVIDER=anthropic. Missing then, the bot refuses to
# start and says so by name; with AI_PROVIDER=openai it is ignored entirely.
ANTHROPIC_API_KEY=

# Models, one per role, so the mechanical roles stay cheap and only the ones
# that have to think cost anything. Unset means the default for the provider
# above: gpt-4o-mini / gpt-5 on OpenAI, claude-opus-5 on Anthropic.
#
# Transcription is an OpenAI model whatever the provider is. whisper-1 still
# works and is still supported here, but it has not been updated since 2022 and
# is measurably worse outside English at the same price per minute.
TRANSCRIPTION_MODEL=gpt-transcribe
FORMATTER_MODEL=gpt-4o-mini
SUMMARY_MODEL=gpt-4o-mini
# Declared, and used by nobody yet: the coach feature arrives over the next few
# releases and reads these. COACH_MODEL is the reasoning-grade one; PROFILE_MODEL
# falls back to SUMMARY_MODEL when it is unset.
COACH_MODEL=gpt-5
PROFILE_MODEL=

# Spoken language as an ISO-639-1 code, for example ru or en. The default,
# "auto", sends nothing and lets the model work it out — which is usually what
# you want, because dictation is rarely monolingual and forcing one language
# mangles the foreign words in it.
TRANSCRIPTION_LANGUAGE=auto

# Comma-separated literal terms to bias the transcriber towards: names of people
# and places, jargon, anything it gets wrong the same way every time. Hints, not
# instructions — a term appears in the transcript only if it is in the audio.
# Sent as `keywords` to current models, folded into whisper-1's `prompt`.
TRANSCRIPTION_KEYWORDS=
# Reject audio larger than this before uploading. The API limit is 25 MB,
# counted the way OpenAI quotes it: 25,000,000 bytes, not 25 MiB.
MAX_AUDIO_MB=25

# Notion HTTP: request timeout, and bounded retries for rate limits and transient
# failures. There is no deadline across a whole save, so the worst case for one
# entry is roughly (number of requests) x (NOTION_MAX_RETRIES + 1) x
# NOTION_TIMEOUT_SECONDS plus backoff. Lower the retries if you would rather a
# bad network failed fast than kept trying.
NOTION_TIMEOUT_SECONDS=30
NOTION_MAX_RETRIES=3
# Seconds before the first retry, doubling after each one. Do not set this to 0:
# it turns a run of 5xx responses into back-to-back requests with no pause.
NOTION_RETRY_BASE_DELAY=1
