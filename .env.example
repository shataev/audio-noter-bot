TELEGRAM_TOKEN=
OPENAI_API_KEY=
NOTION_TOKEN=
NOTION_DATABASE_ID=
# Your Telegram user_id (find it by messaging @userinfobot)
ALLOWED_USER_ID=
# Your timezone, for example Europe/Moscow
TIMEZONE=Europe/Moscow

# --- Optional. Every value below has a default; leave it unset to keep current behaviour. ---

# OpenAI models
TRANSCRIPTION_MODEL=whisper-1
FORMATTER_MODEL=gpt-4o-mini
SUMMARY_MODEL=gpt-4o-mini

# Spoken language as an ISO-639-1 code, for example ru or en.
# Leave empty (or set to "auto") to let the model detect it.
TRANSCRIPTION_LANGUAGE=ru
# Reject audio larger than this before uploading. The API limit is 25 MB.
MAX_AUDIO_MB=25

# Notion HTTP: request timeout, and bounded retries for rate limits and transient failures
NOTION_TIMEOUT_SECONDS=30
NOTION_MAX_RETRIES=3
NOTION_RETRY_BASE_DELAY=1
